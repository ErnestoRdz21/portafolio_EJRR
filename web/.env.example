# Supabase. La anon key es pública: solo permite lo que definan las políticas RLS.
# Nunca pongas SUPABASE_SERVICE_ROLE_KEY en una variable VITE_.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_STORAGE_BUCKET=portfolio

# Origen público del sitio, sin barra final. Vacío hasta tener dominio.
# Activa canonical, og:url y el sitemap del build. No inventar un dominio.
VITE_SITE_URL=

# Opcionales. Si quedan vacíos, el enlace no se muestra.
VITE_GITHUB_URL=
VITE_LINKEDIN_URL=
VITE_EMAIL=
VITE_CV_URL=

# Formulario público de contacto. Apagado salvo que valga "true".
# El POST va a la función /api/contact de Vercel, no a Laravel.
VITE_CONTACT_FORM_ENABLED=

# Solo para Playwright. No entran al build. Definirlas en el entorno, nunca en Git.
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=

# Solo en Vercel, para /api/contact. No usar el prefijo VITE_.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
